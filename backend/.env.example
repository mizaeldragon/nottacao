# Banco de dados (Railway fornece automaticamente)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_POR_CHAVE_FORTE_64_CHARS

# URL do frontend (para CORS)
FRONTEND_URL=https://seu-app.vercel.app

# Asaas
ASAAS_API_URL=https://www.asaas.com/api/v3
ASAAS_API_KEY=sua_chave_asaas_producao
ASAAS_WEBHOOK_TOKEN=gere_um_token_aleatorio_forte
ASAAS_VALOR_ASSINATURA=200

# OpenAI
OPENAI_API_KEY=sk-...

# Super Admin — TROQUE antes de ir ao ar
SUPER_ADMIN_EMAIL=admin@seudominio.com
SUPER_ADMIN_SENHA=senha_muito_forte_aqui

# Email — Gmail com senha de app (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu@gmail.com
EMAIL_PASS=sua_senha_de_app_gmail
EMAIL_FROM=nottacao <seu@gmail.com>
